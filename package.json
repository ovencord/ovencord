{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@ovencord/monorepo",
	"version": "0.0.0",
	"description": "Cooking the future of Discord development. A high-performance, Bun-native monorepo for the Discord ecosystem.",
	"private": true,
	"author": "Luigi Colantuono",
	"license": "MIT",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "bun run --recursive build",
		"test": "bun run --recursive test",
		"lint": "biome check .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"update": "bun --recursive update --interactive",
		"update:latest": "bun --recursive update --interactive --latest",
		"typecheck": "bun run --recursive typecheck"
	},
	"type": "module",
	"contributors": [
		"Ovencord Contributors"
	],
	"keywords": [
		"discord",
		"api",
		"bot",
		"client",
		"bun",
		"ovencord"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ovencord/ovencord.git"
	},
	"bugs": {
		"url": "https://github.com/ovencord/ovencord/issues"
	},
	"homepage": "https://ovencord.dev",
	"funding": {
		"type": "individual",
		"url": "https://paypal.me/l0g4n7"
	},
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@types/bun": "latest",
		"discord-api-types": "^0.38.40",
		"typescript": "^5.9.3"
	},
	"engines": {
		"bun": ">=1.3.0"
	},
	"packageManager": "bun@1.3.9",
	"dependencies": {
		"ts-mixer": "^6.0.4"
	}
}
